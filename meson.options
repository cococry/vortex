option('backends',
  type: 'combo',
  value: 'all',
  choices: ['drm', 'wayland', 'all'],
  description: 'Sink backends to build')

option(
  'renderers',
  type: 'combo',
  choices: ['opengl', 'vulkan', 'all'],
  value: 'opengl',
  description: 'Rendering backends to build'
)

option('background-client',
  type: 'boolean',
  value: false,
  description: 'Build the Runara Vulkan background example client')
