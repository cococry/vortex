option('vt_backend_drm',
  type: 'feature',
  value: 'auto',
  description: 'Enable DRM backend (auto: only if gbm, libdrm and libseat are found)')

option('vt_backend_wl',
  type: 'boolean',
  value: true,
  description: 'Enable Wayland backend')


option(
  'vt_render_backends',
  type: 'combo',
  choices: ['opengl', 'vulkan', 'all'],
  value: 'all',
  description: 'Rendering backends to build'
)
